{
  "name": "storefront-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev --filter=@sf/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @sf/web e2e",
    "db:generate": "pnpm --filter @sf/db generate",
    "preflight": "pnpm --filter @sf/core preflight"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
