# Copy to apps/web/.env.local. Every value is optional in development:
# with nothing set, the app uses an in-process Postgres (PGlite) and fake providers.

# Brand (placeholder until the brand step)
NEXT_PUBLIC_BRAND_NAME="Storefront"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# Database: leave empty for PGlite (stored in .data/). Set for Supabase Postgres.
DATABASE_URL=

# Payments: "fake" (default) or "stripe"
PAYMENTS_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Suppliers. The demo supplier lets you try import, routing and tracking with no account;
# set DEMO_SUPPLIER=off in production. CJ Dropshipping turns on when CJ_API_KEY is set.
DEMO_SUPPLIER=on
DEMO_SUPPLIER_SHIP_AFTER_SECONDS=0
CJ_API_KEY=

# Email: with RESEND_API_KEY empty, emails are logged to the console and kept in the emails table.
RESEND_API_KEY=
EMAIL_FROM=

# Scheduled job (/api/cron/fulfillment): places missed orders and pulls tracking.
# Required in production; the scheduler sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
