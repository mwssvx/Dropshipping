# Copy to apps/web/.env.local. Every value is optional in development:
# with nothing set, the app uses an in-process Postgres (PGlite) and fake providers.

# Brand (placeholder until the brand step)
NEXT_PUBLIC_BRAND_NAME="Storefront"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# Database: leave empty for PGlite (stored in .data/). Set for Supabase Postgres.
DATABASE_URL=

# Payments: "fake" (default) or "stripe"
PAYMENTS_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Billing price ids for the paid plans (monthly, USD). Free needs none.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
# Use Stripe Tax for tax calculation (on each store's own Stripe account). Off: built-in national/state rates.
STRIPE_TAX=
# Comma-separated emails of platform staff who can open /staff to send notices and answer appeals.
STAFF_EMAILS=

# Suppliers. The demo supplier lets you try import, routing and tracking with no account;
# set DEMO_SUPPLIER=off in production. CJ Dropshipping turns on when CJ_API_KEY is set.
DEMO_SUPPLIER=on
DEMO_SUPPLIER_SHIP_AFTER_SECONDS=0
CJ_API_KEY=

# Email: with RESEND_API_KEY empty, emails are logged to the console and kept in the emails table.
RESEND_API_KEY=
EMAIL_FROM=

# Scheduled job (/api/cron/fulfillment): places missed orders and pulls tracking.
# Required in production; the scheduler sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Custom domains. With a Vercel API token and project id, domains merchants add are attached to
# the Vercel project, which issues certificates. Without them, the app only checks public DNS.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Where merchants point their DNS (defaults are Vercel's).
DOMAIN_A_RECORD=76.76.21.21
DOMAIN_CNAME_TARGET=cname.vercel-dns.com
# Automated tests only: connect domains without any DNS check. Never set in production.
DOMAIN_CHECKS=

# AI agents. With no key, a built-in demo brain answers using the same tools and approval rules.
ANTHROPIC_API_KEY=
# Model the agents use.
AI_MODEL=claude-opus-5-5

# Push notifications to the merchant app go through Expo's push service. "log" only prints them.
PUSH_PROVIDER=
# Optional: an Expo access token, if push security is turned on for the Expo project.
EXPO_ACCESS_TOKEN=
# Browser origins allowed to call the app API (only the app's web build needs this; phones don't).
APP_WEB_ORIGINS=

# Development and tests only: let webhooks go to http:// and private-network addresses. Never in production.
WEBHOOKS_ALLOW_PRIVATE=
# Development and tests only: show emails at /dev/mail instead of sending them (when RESEND_API_KEY is empty).
EMAIL_PREVIEW=
# Development and tests only: "static" uses fixed exchange rates instead of the European Central Bank's daily ones.
FX_PROVIDER=
